# Local mock development only. Generate your own secret (see README).
# At least 32 UTF-8 bytes, not whitespace-only; generate a random value.
MOCK_WEBHOOK_SECRET=
# Persistent local file. Empty paths, :memory:, and SQLite URIs are rejected.
# If omitted, the server selects ./guardian.sqlite. Network shares are unsupported.
DATABASE_PATH=./guardian.sqlite
HOST=127.0.0.1
PORT=3000
