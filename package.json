{
  "name": "webhook-guardian",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Community mock webhook receiver with persistent local deduplication",
  "type": "module",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json",
    "start": "node --env-file=.env dist/server.js",
    "test": "vitest run",
    "demo": "npm run build && node scripts/run-demo.mjs"
  },
  "dependencies": { "fastify": "^5.6.0", "zod": "^4.1.0" },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^5.9.0", "vitest": "^5.0.4" }
}
